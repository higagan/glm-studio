# ── Supabase (frontend) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ── Supabase (serverless API functions) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose to frontend

# ── Google Maps ───────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Resend (email notifications) ─────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key

# ── App URL (used in email templates) ────────────────────────────────────────
APP_URL=https://medibrick.com

# ── Sentry (error monitoring) ────────────────────────────────────────────────
# Create a project at sentry.io → Settings → Projects → Client Keys (DSN)
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Used at build time to upload source maps. Get from sentry.io → Settings → Auth Tokens
# Add to Vercel env vars as "Production only" — never needed at runtime
# Also used by /api/founder-metrics for Sentry issue summary
SENTRY_AUTH_TOKEN=sntrys_your-auth-token

# ── Founder admin gate (password-only /admin access) ─────────────────────────
# Set in Vercel (Production). Never commit the real password.
ADMIN_PASSWORD=your-team-password
